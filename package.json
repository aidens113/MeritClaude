{
  "name": "meritclaude",
  "version": "0.1.0",
  "type": "module",
  "description": "Global Claude Code rules, tiered Haiku/Sonnet/Opus agents, enforcement hooks, and automatic git and npm release management",
  "repository": { "type": "git", "url": "https://github.com/aidens113/MeritClaude.git" },
  "homepage": "https://github.com/aidens113/MeritClaude#readme",
  "bugs": { "url": "https://github.com/aidens113/MeritClaude/issues" },
  "bin": { "meritclaude": "bin/meritclaude.mjs" },
  "files": ["AGENTS.md", "agents", "bin", "hooks", "lessons", "skills", "templates", "tools", "install.mjs"],
  "scripts": {
    "test": "node --test tests/hooks.test.mjs tests/git.test.mjs tests/install.test.mjs tests/working-docs-audit.test.mjs",
    "install-config": "node install.mjs",
    "usage": "node tools/usage-report.mjs",
    "branch": "node tools/branch.mjs"
  },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" }
}
